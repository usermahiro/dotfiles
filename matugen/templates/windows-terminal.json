      "green": "#9fd49b",
      "yellow": "#e8c87a",
      "blue": "{{colors.primary.default.hex}}",
      "purple": "{{colors.tertiary.default.hex}}",
      "cyan": "{{colors.secondary.default.hex}}",
      "white": "<* if {{ is_dark_mode }} *>{{colors.on_surface_variant.default.hex}}<* else *>#3a3a3a<* endif *>",
