.shell powershell

# =====================================================================
# Keybind meniru hyprdots (SUPER = win).
# whkd memakai low-level hook, jadi bisa menimpa shortcut bawaan Windows
# (Win+A, Win+Z, dst.). Pengecualian: Win+L (lock) tidak bisa ditimpa
# oleh aplikasi apa pun, jadi vim-key "l" untuk fokus tidak dipetakan.
# =====================================================================

# --- Reload ----------------------------------------------------------
win + ctrl + o          : taskkill /f /im whkd.exe; Start-Process whkd -windowStyle hidden
win + shift + o         : komorebic reload-configuration

# --- Window --------------------------------------------------------
win + q                 : komorebic close
win + w                 : komorebic toggle-float
win + g                 : komorebic toggle-monocle     # hypr: fullscreen
win + f                 : komorebic toggle-maximize    # hypr: fullscreen 1 (bar tetap terlihat)

# --- Launch --------------------------------------------------------
# win + enter  -> wt.exe, ditangani elrond.ahk (tidak berubah)
# alt + space  -> Flow Launcher (bawaan)
win + z                 : Start-Process zen
win + o                 : rundll32.exe user32.dll,LockWorkStation
win + a                 : Start-Process ms-settings:apps-volume
win + ctrl + b          : Start-Process powershell -WindowStyle Hidden -ArgumentList '-NoProfile','-STA','-File',"$env:USERPROFILE\.config\windots-hypr\pick-wallpaper.ps1"

# --- Fokus (win + panah / hjk) -------------------------------------
win + left              : komorebic focus left
win + down              : komorebic focus down
win + up                : komorebic focus up
win + right             : komorebic focus right
win + h                 : komorebic focus left
win + j                 : komorebic focus down
win + k                 : komorebic focus up
# win + l tidak bisa dipakai (lock bawaan Windows)

# --- Pindah jendela (win + shift + panah / hjkl) -------------------
win + shift + left      : komorebic move left
win + shift + down      : komorebic move down
win + shift + up        : komorebic move up
win + shift + right     : komorebic move right
win + shift + h         : komorebic move left
win + shift + j         : komorebic move down
win + shift + k         : komorebic move up
win + shift + l         : komorebic move right
win + shift + return    : komorebic promote

# --- Resize (win + alt + panah / hjkl) -----------------------------
win + alt + left        : komorebic resize-axis horizontal decrease
win + alt + right       : komorebic resize-axis horizontal increase
win + alt + up          : komorebic resize-axis vertical decrease
win + alt + down        : komorebic resize-axis vertical increase
win + alt + h           : komorebic resize-axis horizontal decrease
win + alt + l           : komorebic resize-axis horizontal increase
win + alt + k           : komorebic resize-axis vertical decrease
win + alt + j           : komorebic resize-axis vertical increase

# --- Workspace 1-10 (angka 0 = workspace 10) -----------------------
win + 1                 : komorebic focus-workspace 0
win + 2                 : komorebic focus-workspace 1
win + 3                 : komorebic focus-workspace 2
win + 4                 : komorebic focus-workspace 3
win + 5                 : komorebic focus-workspace 4
win + 6                 : komorebic focus-workspace 5
win + 7                 : komorebic focus-workspace 6
win + 8                 : komorebic focus-workspace 7
win + 9                 : komorebic focus-workspace 8
win + 0                 : komorebic focus-workspace 9

# Pindahkan jendela ke workspace lalu ikut pindah (movetoworkspace)
win + shift + 1         : komorebic move-to-workspace 0
win + shift + 2         : komorebic move-to-workspace 1
win + shift + 3         : komorebic move-to-workspace 2
win + shift + 4         : komorebic move-to-workspace 3
win + shift + 5         : komorebic move-to-workspace 4
win + shift + 6         : komorebic move-to-workspace 5
win + shift + 7         : komorebic move-to-workspace 6
win + shift + 8         : komorebic move-to-workspace 7
win + shift + 9         : komorebic move-to-workspace 8
win + shift + 0         : komorebic move-to-workspace 9

# Kirim jendela tanpa ikut pindah (movetoworkspacesilent)
win + ctrl + 1          : komorebic send-to-workspace 0
win + ctrl + 2          : komorebic send-to-workspace 1
win + ctrl + 3          : komorebic send-to-workspace 2
win + ctrl + 4          : komorebic send-to-workspace 3
win + ctrl + 5          : komorebic send-to-workspace 4
win + ctrl + 6          : komorebic send-to-workspace 5
win + ctrl + 7          : komorebic send-to-workspace 6
win + ctrl + 8          : komorebic send-to-workspace 7
win + ctrl + 9          : komorebic send-to-workspace 8
win + ctrl + 0          : komorebic send-to-workspace 9

# --- Bawaan config lama kamu (tidak ada padanannya di hyprdots) -----
win + space             : komorebic minimize
win + shift + r         : komorebic retile
win + p                 : komorebic toggle-pause
win + ctrl + left       : komorebic stack left
win + ctrl + down       : komorebic stack down
win + ctrl + up         : komorebic stack up
win + ctrl + right      : komorebic stack right
win + shift + space     : komorebic unstack
win + shift + tab       : komorebic cycle-stack previous
win + tab               : komorebic cycle-stack next

# Dibiarkan ke fitur bawaan Windows (sudah setara hyprdots):
#   Win+V clipboard history   Win+.  emoji     Win+N  notifikasi
#   Win+R run                 Win+S  search    Win+E  explorer
#   Ctrl+Shift+Esc task mgr   PrtScn snipping tool
